diff --git a/src/zhlt-vluzacn/common/bspfile.cpp b/src/zhlt-vluzacn/common/bspfile.cpp
index cd35d3d..71c0bd0 100644
--- a/src/zhlt-vluzacn/common/bspfile.cpp
+++ b/src/zhlt-vluzacn/common/bspfile.cpp
@@ -277,10 +277,19 @@ static void     SwapBSPFile(const bool todisk)
     //      
     for (i = 0; i < g_numtexinfo; i++)
     {
-        for (j = 0; j < 8; j++)
+        // vecs is float[2][4]; swap both rows explicitly instead of walking
+        // vecs[0][0..7], which reads past the end of vecs[0] into vecs[1]'s
+        // memory (relies on the two rows being contiguous - undefined
+        // behavior, and the source of a real "iteration invokes undefined
+        // behavior" compiler warning even though it happens to work here).
+        for (j = 0; j < 4; j++)
         {
             g_texinfo[i].vecs[0][j] = LittleFloat(g_texinfo[i].vecs[0][j]);
         }
+        for (j = 0; j < 4; j++)
+        {
+            g_texinfo[i].vecs[1][j] = LittleFloat(g_texinfo[i].vecs[1][j]);
+        }
         g_texinfo[i].miptex = LittleLong(g_texinfo[i].miptex);
         g_texinfo[i].flags = LittleLong(g_texinfo[i].flags);
     }
