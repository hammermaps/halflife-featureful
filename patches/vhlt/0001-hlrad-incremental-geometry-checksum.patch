+/*
+ * =============
+ * GeometryChecksum
+ *
+ * FNV-1a 64-bit hash over the geometry-derived fields of every patch
+ * (origin, area, owning face), in patch order. Stored in the .inc
+ * incremental transfer cache alongside the patch count, and recomputed
+ * on read, so a geometry edit that keeps the same patch count (e.g. a
+ * brush moved without changing face/patch topology) still invalidates
+ * the cache instead of silently reusing a stale transfer matrix.
+ * =============
+ */
+static uint64_t GeometryChecksum(const long numpatches)
+{
+    uint64_t        hash = 0xcbf29ce484222325ULL; // FNV-1a 64-bit offset basis
+    const uint64_t  prime = 0x100000001b3ULL;
+    patch_t*        patch;
+    long            patchcount = numpatches;
+
+    for (patch = g_patches; patchcount-- > 0; patch++)
+    {
+        const unsigned char* bytes;
+        size_t          i;
+
+        bytes = (const unsigned char*)&patch->origin;
+        for (i = 0; i < sizeof(patch->origin); i++)
+        {
+            hash ^= bytes[i];
+            hash *= prime;
+        }
+
+        bytes = (const unsigned char*)&patch->area;
+        for (i = 0; i < sizeof(patch->area); i++)
+        {
+            hash ^= bytes[i];
+            hash *= prime;
+        }
+
+        bytes = (const unsigned char*)&patch->faceNumber;
+        for (i = 0; i < sizeof(patch->faceNumber); i++)
+        {
+            hash ^= bytes[i];
+            hash *= prime;
+        }
+    }
+
+    return hash;
+}
