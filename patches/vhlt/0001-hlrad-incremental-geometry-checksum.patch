+/*
+ * =============
+ * HashBytes
+ *
+ * Folds len bytes at data into an FNV-1a 64-bit hash.
+ * =============
+ */
+static inline void HashBytes(uint64_t& hash, const void* data, size_t len)
+{
+    const uint64_t        prime = 0x100000001b3ULL;
+    const unsigned char*  bytes = (const unsigned char*)data;
+    size_t                i;
+
+    for (i = 0; i < len; i++)
+    {
+        hash ^= bytes[i];
+        hash *= prime;
+    }
+}
+
+/*
+ * =============
+ * GeometryChecksum
+ *
+ * FNV-1a 64-bit hash over the geometry-derived fields of every patch
+ * (origin, area, owning face, and the full winding point list), in patch
+ * order. Stored in the .inc incremental transfer cache alongside the
+ * patch count, and recomputed on read, so a geometry edit that keeps the
+ * same patch count (e.g. a brush moved, or rotated in place around its
+ * own centroid, without changing face/patch topology) still invalidates
+ * the cache instead of silently reusing a stale transfer matrix.
+ * =============
+ */
+static uint64_t GeometryChecksum(const long numpatches)
+{
+    uint64_t        hash = 0xcbf29ce484222325ULL; // FNV-1a 64-bit offset basis
+    patch_t*        patch;
+    long            patchcount = numpatches;
+
+    for (patch = g_patches; patchcount-- > 0; patch++)
+    {
+        HashBytes(hash, &patch->origin, sizeof(patch->origin));
+        HashBytes(hash, &patch->area, sizeof(patch->area));
+        HashBytes(hash, &patch->faceNumber, sizeof(patch->faceNumber));
+
+        if (patch->winding)
+        {
+            unsigned int numpoints = patch->winding->m_NumPoints;
+
+            HashBytes(hash, &numpoints, sizeof(numpoints));
+            HashBytes(hash, patch->winding->m_Points, numpoints * sizeof(vec3_t));
+        }
+    }
+
+    return hash;
+}
